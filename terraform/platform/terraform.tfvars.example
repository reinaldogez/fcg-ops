aws_region = "us-east-1"

name_prefix     = "fcg-"
broker_username = "fcg"

# endereco do autor em notacao CIDR; /32 e um host unico. o valor abaixo vem do
# bloco reservado a documentacao pela RFC 5737 e nao e roteavel.
admin_cidr = "203.0.113.10/32"

# conteudo da chave publica gerada fora do Terraform; a privada fica so na
# maquina do autor. o exemplo esta truncado de proposito: copiado cru, ele falha
# no registro do par de chaves em vez de registrar material invalido.
chave_publica_ssh = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... autor@maquina"

# interruptor de bootstrap, de uso unico na vida da conta. a criacao do
# authorizer chama o discovery do issuer, servido pelo identity atras da rota
# aberta -- que so responde depois do cluster de pe. dai a ordem: aplicar uma vez
# com falso, subir o cluster, e aplicar de novo no padrao.
#
# fica comentado de proposito: o padrao verdadeiro e o estado correto, e aplicar
# com falso numa sessao comum derruba a autenticacao da borda.
# authorizer_ligado = false
