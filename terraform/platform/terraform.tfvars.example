aws_region = "us-east-1"

name_prefix     = "fcg-"
broker_username = "fcg"

# interruptor da autenticacao de borda. a criacao do authorizer chama o
# discovery do issuer, servido pelo identity atras da rota aberta -- que so
# responde depois do cluster de pe. dai a ordem numa conta nova: aplicar uma vez
# com falso, subir o cluster, e aplicar de novo no padrao. o outro uso do falso
# e o plan -destroy final da borda.
#
# fica comentado de proposito: o padrao verdadeiro e o estado correto, e aplicar
# com falso numa sessao comum derruba a autenticacao da borda.
# authorizer_ligado = false

# leitura do discovery antes de criar o authorizer, so na fase 2 de uma conta
# nova: e ela que mostra a falta do discovery antes do apply quebrar no meio. em
# qualquer outro plano a leitura falharia com o cluster desligado, que e o
# estado normal entre sessoes.
# verificar_discovery = true
