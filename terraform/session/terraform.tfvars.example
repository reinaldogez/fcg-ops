aws_region = "us-east-1"

# tem que coincidir com o valor do root permanente: e por este prefixo que as
# consultas acham a VPC, a sub-rede e o segredo. divergencia aqui aparece como
# recurso nao encontrado, e nao como prefixo errado.
name_prefix = "fcg-"

broker_engine_version = "3.13"

# so o perfil com funcao serverless liga: os tres endpoints de interface do
# mapeamento cobram por hora, e a sessao comum nao os usa.
# funcao_ligada = true

# por padrao o pipeline entra so pelo grupo fcg-cd, pelo Role proprio do
# namespace, e o RoleBinding precisa estar aplicado antes do primeiro deploy,
# senao todo run recebe 403. ligar a policy de edicao e o fallback, se um run
# der Forbidden por verbo que falta no Role; a abertura passa a ter 3 recursos a mais.
# cd_politica_edicao = true
