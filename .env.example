# .env.example — template das variaveis que o docker-compose.yml interpola via ${VAR}.
# Uso: copie para .env (cp .env.example .env) e preencha com valores reais.
# O .env real NAO e versionado; este .example contem apenas placeholders.
#
# A chave RSA de assinatura JWT NAO entra aqui: um PEM multilinha quebra o parsing
# do .env. Ela vive no docker-compose.override.yml (nao-versionado) como block
# scalar em environment:. Gere a chave com scripts/gen-rsa-key.sh e cole-a no
# override (template: docker-compose.override.example.yml).

# ---------- SQL Server (identity) ----------
SQLSERVER_SA_PASSWORD=ChangeMe_StrongP@ss123

# ---------- RabbitMQ ----------
RABBITMQ_USER=fcg
RABBITMQ_PASSWORD=ChangeMe_RabbitP@ss123

# ---------- Identity (aplicacao) ----------
# Use a MESMA senha de SQLSERVER_SA_PASSWORD no campo Password= abaixo.
# O .env nao expande ${VAR} dentro de outro valor: preencha a mao nos dois lugares.
IDENTITY_DB_CONNECTION=Server=sqlserver-identity;Database=identity;User Id=sa;Password=ChangeMe_StrongP@ss123;TrustServerCertificate=True
ADMINSEED_PASSWORD=ChangeMe_AdminP@ss123

# ---------- Redis ----------
# Use a MESMA senha em REDIS_PASSWORD e no campo password= de REDIS_CONNECTION.
# O .env nao expande ${VAR} dentro de outro valor: preencha a mao nos dois lugares.
REDIS_PASSWORD=ChangeMe_RedisP@ss123
REDIS_CONNECTION=redis:6379,password=ChangeMe_RedisP@ss123

# ---------- PostgreSQL (catalog) ----------
# Use a MESMA senha em POSTGRES_CATALOG_PASSWORD e no campo Password= de
# CATALOG_DB_CONNECTION. O .env nao expande ${VAR} dentro de outro valor:
# preencha a mao nos dois lugares.
POSTGRES_CATALOG_PASSWORD=ChangeMe_StrongP@ss123
CATALOG_DB_CONNECTION=Host=postgres-catalog;Database=catalog;Username=postgres;Password=ChangeMe_StrongP@ss123

# ---------- PostgreSQL (payments) ----------
# Use a MESMA senha em POSTGRES_PAYMENTS_PASSWORD e no campo Password= de
# PAYMENTS_DB_CONNECTION. O .env nao expande ${VAR} dentro de outro valor:
# preencha a mao nos dois lugares.
POSTGRES_PAYMENTS_PASSWORD=ChangeMe_StrongP@ss123
PAYMENTS_DB_CONNECTION=Host=postgres-payments;Database=payments;Username=postgres;Password=ChangeMe_StrongP@ss123

# ---------- Config que varia por ambiente ----------
# Estas seis NAO sao credencial, mas mudam entre o cluster local e o da nuvem: por isso
# ficam fora do ConfigMap versionado. O init-secrets.sh le daqui e gera os
# configmap-env.yaml de cada servico, que nao sao versionados.
# Os valores abaixo sao os do ambiente local — na nuvem, veja o comentario de cada uma.

# Broker. Local: o servico do cluster, sem TLS. Nuvem: o endpoint do broker gerenciado,
# porta 5671 e TLS ligado.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USE_SSL=false

# Emissor do token. Local: um nome simples basta. Nuvem: a URL do gateway — quem valida
# o token precisa conseguir resolver o emissor.
JWT_ISSUER=fcg-identity

# Base publica anunciada no discovery do identity. Vazia no local (nao ha endereco
# externo); na nuvem, a URL do gateway.
# Pode ficar vazia, mas a linha precisa existir: o init-secrets.sh cobra a declaracao.
JWT_PUBLIC_BASE_URL=

# Endpoint do emulador do read model. Local: o servico do cluster. Nuvem: deixe vazia —
# o SDK resolve o servico gerenciado pela regiao.
# Mesma regra da anterior: pode ser vazia, mas a linha precisa existir.
DYNAMODB_SERVICE_URL=http://dynamodb-local:8000
