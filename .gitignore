# Build output
bin/
obj/

# IDE / user-specific
.vs/
*.user
*.suo

# Local environment (real values never committed)
.env

# Local compose overrides
docker-compose.override.yml

# RSA demo keys (real key material never committed)
*.pem

# Kubernetes Secrets reais (copiados do .example, preenchidos fora do git)
secret.yaml
secret-jwt.yaml

# Relatorio da varredura de segredos (contem os trechos casados)
gitleaks-report.json

# Terraform: diretorio de trabalho, estado (contem valor sensivel em texto plano)
# e variaveis reais. O *.tfvars.example continua versionado.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# Plano salvo: resolve os valores do estado, entao um plano gerado com a infra de
# pe carrega a senha do broker em claro. O padrao de extensao vale em qualquer
# lugar de proposito -- plano salvo fora da pasta e o erro que a regra precisa pegar.
terraform/plans/*
!terraform/plans/.gitkeep
*.tfplan

# ConfigMaps gerados por script (valor que varia por ambiente)
configmap-env.yaml
